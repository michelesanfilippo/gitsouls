# A GitHub token unlocks the GraphQL contribution stats (VIT / END / streak)
# and raises the API rate limit. Create a classic token with NO scopes
# (public data only) at https://github.com/settings/tokens
#
# Local dev: copy this file to .env.local and fill in the value.
# Vercel:    add GITHUB_TOKEN as a Project Environment Variable.
GITHUB_TOKEN=

# Upstash Redis, used only by the "N souls summoned" counter. Add the Upstash
# integration from the Vercel Marketplace and these are injected automatically
# (as KV_REST_API_URL / KV_REST_API_TOKEN). Leave them empty and the counter
# badge simply doesn't render — nothing else is affected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
